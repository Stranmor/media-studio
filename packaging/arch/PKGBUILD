pkgname=media-studio
pkgver=0.2.2
pkgrel=1
pkgdesc='Dolphin-integrated local media conversion studio'
arch=('x86_64' 'aarch64')
url='https://github.com/Stranmor/media-studio'
license=('MIT')
depends=('ffmpeg' 'kio' 'systemd')
makedepends=('git' 'rust')
optdepends=(
  'imagemagick: image conversion profiles'
  'zenity: single-window advanced settings'
  'kdialog: KDE fallback advanced settings'
)
# Release packages are built from the matching immutable release tag, never
# from a moving branch. The prepare check rejects an unexpected checkout.
source=("git+https://github.com/Stranmor/media-studio.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/media-studio"
  expected_tag="v$pkgver"
  test "$(git describe --tags --exact-match HEAD 2>/dev/null)" = "$expected_tag"
}

build() {
  cd "$srcdir/media-studio"
  cargo build --release
}

package() {
  cd "$srcdir/media-studio"
  install -Dm755 target/release/media-studio "$pkgdir/usr/bin/media-studio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
