pkgname=media-studio-git
pkgver=0.2.1
pkgrel=1
pkgdesc='Dolphin-integrated local media conversion studio'
arch=('x86_64' 'aarch64')
url='https://github.com/Stranmor/media-studio'
license=('MIT')
depends=('ffmpeg' 'kio' 'systemd')
makedepends=('git' 'rust')
optdepends=(
  'imagemagick: image conversion profiles'
  'zenity: single-window advanced settings'
  'kdialog: KDE fallback advanced settings'
)
source=('git+https://github.com/Stranmor/media-studio.git#commit=63dc708153b76ab7f7527579f103ce24ac106872')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/media-studio"
  printf '0.2.1.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/media-studio"
  cargo build --release
}

package() {
  cd "$srcdir/media-studio"
  install -Dm755 target/release/media-studio "$pkgdir/usr/bin/media-studio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
