pkgname=media-studio
pkgver=0.2.5
pkgrel=1
pkgdesc='Dolphin-integrated local media conversion studio'
arch=('x86_64' 'aarch64')
url='https://github.com/Stranmor/media-studio'
license=('MIT')
depends=('ffmpeg' 'kio' 'systemd')
makedepends=('git' 'rust')
optdepends=(
  'imagemagick: image conversion profiles'
  'zenity: single-window advanced settings'
  'kdialog: KDE fallback advanced settings'
)
# Release packages are built from the matching release tag and verify the
# resolved commit before compiling, never from a moving branch.
source_repo='https://github.com/Stranmor/media-studio.git'
source_tag="v$pkgver"
source_helper="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/verify-source.sh"
source_commit="${MEDIA_STUDIO_SOURCE_COMMIT:-}"
source=("git+$source_repo#tag=$source_tag")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/media-studio"
  if [[ -z "$source_commit" ]]; then
    source_commit="$($source_helper --resolve --repo "$source_repo" --tag "$source_tag")"
  fi
  test "$(git rev-parse HEAD)" = "$source_commit"
  test "$(git describe --tags --exact-match HEAD 2>/dev/null)" = "$source_tag"
}

build() {
  cd "$srcdir/media-studio"
  cargo build --release
}

package() {
  cd "$srcdir/media-studio"
  install -Dm755 target/release/media-studio "$pkgdir/usr/bin/media-studio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
